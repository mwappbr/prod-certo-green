{
  "name": "@hn/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "npm run build && node dist/main.js",
    "start": "node dist/main.js",
    "lint": "eslint src --config eslint.config.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@hn/shared": "*",
    "entities": "^8.1.0",
    "fastify": "^5.12.5",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^7.0.2"
  }
}
